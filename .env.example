# ============================================================
# MikroKing - Configuração da conexão com o Mikrotik
# ============================================================
# Copie este arquivo para ".env" e ajuste os valores.

# --- Conexão com a API nativa do RouterOS ---
MIKROTIK_HOST=192.168.88.0
MIKROTIK_USER=api_001
MIKROTIK_PASS=ssdsad

# false = API nativa (porta 8728)
# true  = API-SSL   (porta 8729)
MIKROTIK_USE_SSL=false
# Se não informar, será 8728 ou 8729 conforme MIKROTIK_USE_SSL
# MIKROTIK_API_PORT=8728
MIKROTIK_API_TIMEOUT=10

# --- Detecção dos links WAN ---
# Opcional: force os nomes das interfaces WAN, separados por vírgula.
# Se vazio, o painel detecta pelas rotas default ativas.
# Exemplo: ether1,pppoe-out1
WAN_INTERFACES=

# Nomes amigáveis dos links, na mesma ordem de WAN_INTERFACES
WAN_LABELS=ether2,ether3

# Como medir latência de cada link:
# gateway = pinga o next-hop/gateway do link (recomendado para failover)
# public  = pinga WAN_PING_TARGET forçando a saída pela interface
WAN_PING_MODE=gateway
WAN_PING_TARGET=8.8.8.8

# --- Painel ---
REFRESH_INTERVAL=5
MAX_DATA_POINTS=60
LATENCY_WARNING_MS=80
LATENCY_CRITICAL_MS=150